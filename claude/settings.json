{
  "model": "opus[1m]",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -c \"import json; print(json.dumps({'terminalSequence': chr(7)}))\""
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -c \"\nimport json,sys\ntry: tipo = json.load(sys.stdin).get('notification_type')\nexcept Exception: tipo = None\nprint(json.dumps({'terminalSequence': chr(7)}) if tipo != 'idle_prompt' else '{}')\n\""
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.pl"
  },
  "enabledPlugins": {
    "claude-mem@thedotmack": false
  },
  "extraKnownMarketplaces": {
    "thedotmack": {
      "source": {
        "source": "github",
        "repo": "thedotmack/claude-mem"
      }
    }
  },
  "effortLevel": "xhigh",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "high"
    }
  }
}
