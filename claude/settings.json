{
  "model": "opus[1m]",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -c \"\nimport json,os\np=os.path.expanduser('~/.claude/memory/MEMORY.md')\ntry: t=open(p,encoding='utf-8').read().strip()\nexcept Exception: t=''\nprint(json.dumps({'suppressOutput':True,'hookSpecificOutput':{'hookEventName':'SessionStart','additionalContext':'Memoria global ('+p+'):\\n'+t}}) if t else '{}')\n\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/tasks-brief.py show",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/tasks-brief.py refresh",
            "timeout": 240,
            "statusMessage": "Actualizando brief de tareas",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -c \"import json; print(json.dumps({'terminalSequence': chr(7)}))\""
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -c \"\nimport json,sys\ntry: tipo = json.load(sys.stdin).get('notification_type')\nexcept Exception: tipo = None\nprint(json.dumps({'terminalSequence': chr(7)}) if tipo != 'idle_prompt' else '{}')\n\""
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.pl"
  },
  "enabledPlugins": {
    "claude-mem@thedotmack": false
  },
  "extraKnownMarketplaces": {
    "thedotmack": {
      "source": {
        "source": "github",
        "repo": "thedotmack/claude-mem"
      }
    }
  },
  "effortLevel": "xhigh",
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "xhigh"
    }
  },
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true
}
